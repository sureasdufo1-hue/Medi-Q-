# Local-only template. Copy to .env and replace placeholders before starting.
# The DATABASE_URL password must match MEDIQ_POSTGRES_PASSWORD; use separate
# random passwords for Orthanc A and B. Never use these values in production.

# Application
MEDIQ_ENV=development
MEDIQ_LOG_LEVEL=INFO
MEDIQ_API_PORT=8080

# Database (local development only)
MEDIQ_POSTGRES_USER=mediq
MEDIQ_POSTGRES_PASSWORD=replace-before-start-database
MEDIQ_POSTGRES_DB=mediq
MEDIQ_DATABASE_URL=postgresql://mediq:replace-before-start-database@postgres:5432/mediq

# Test Orthanc endpoints
ORTHANC_A_URL=http://orthanc-a:8042
ORTHANC_A_USERNAME=orthanc
ORTHANC_A_PASSWORD=replace-before-start-orthanc-a
ORTHANC_A_DICOM_HOST_PORT=14242
ORTHANC_A_HTTP_HOST_PORT=18042
ORTHANC_B_URL=http://orthanc-b:8042
ORTHANC_B_USERNAME=orthanc
ORTHANC_B_PASSWORD=replace-before-start-orthanc-b
ORTHANC_B_DICOM_HOST_PORT=14243
ORTHANC_B_HTTP_HOST_PORT=18043

# Security placeholders; replace with locally generated development values.
MEDIQ_SIGNING_KEY_ID=dev-only
MEDIQ_ENCRYPTION_KEY=change-me

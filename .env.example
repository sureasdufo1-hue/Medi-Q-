# Local-only template. Copy to the ignored .env, then run
# scripts/setup-local-postgres-roles.ps1 and scripts/validate-app-config.ps1.
# Bootstrap, migration and runtime database credentials are separate. Never
# inject bootstrap or migration credentials into the API/Worker process.

# Application
MEDIQ_ENV=development
MEDIQ_LOG_LEVEL=INFO
MEDIQ_API_PORT=8080
MEDIQ_RUNTIME_PROFILE=container
# Optional OIDC verifier settings. Leave all empty to keep protected APIs fail-closed (503).
MEDIQ_OIDC_ISSUER=
MEDIQ_OIDC_AUDIENCE=
MEDIQ_OIDC_JWKS_URI=

# PostgreSQL bootstrap account: initialization/role provisioning only.
MEDIQ_POSTGRES_USER=mediq
MEDIQ_POSTGRES_PASSWORD=replace-before-start-database-bootstrap
MEDIQ_POSTGRES_DB=mediq

# The setup script generates distinct local passwords and synchronizes URLs.
# The API gets only MEDIQ_DATABASE_URL (the non-superuser runtime role).
MEDIQ_DB_RUNTIME_USER=mediq_runtime
MEDIQ_DB_RUNTIME_PASSWORD=replace-before-start-runtime-role
MEDIQ_DATABASE_URL=postgresql://mediq_runtime:replace-before-start-runtime-role@postgres:5432/mediq
MEDIQ_DB_MIGRATION_USER=mediq_migrator
MEDIQ_DB_MIGRATION_PASSWORD=replace-before-start-migration-role
MEDIQ_MIGRATION_DATABASE_URL=postgresql://mediq_migrator:replace-before-start-migration-role@postgres:5432/mediq

# Test Orthanc endpoints
ORTHANC_A_URL=https://orthanc-a:8042
ORTHANC_A_USERNAME=orthanc
ORTHANC_A_PASSWORD=replace-before-start-orthanc-a
ORTHANC_B_URL=https://orthanc-b:8042
ORTHANC_B_USERNAME=orthanc
ORTHANC_B_PASSWORD=replace-before-start-orthanc-b

# Identifier only; no signing/encryption key material is implemented by this env.
MEDIQ_SIGNING_KEY_ID=dev-only

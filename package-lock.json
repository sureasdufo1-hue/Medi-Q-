{
  "name": "mediq",
  "version": "0.1.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "mediq",
      "version": "0.1.0",
      "workspaces": [
        "services/api",
        "services/worker",
        "web"
      ],
      "engines": {
        "node": ">=24 <25",
        "npm": ">=11 <12"
      }
    },
    "node_modules/@mediq/api": {
      "resolved": "services/api",
      "link": true
    },
    "node_modules/@mediq/web": {
      "resolved": "web",
      "link": true
    },
    "node_modules/@mediq/worker": {
      "resolved": "services/worker",
      "link": true
    },
    "services/api": {
      "name": "@mediq/api",
      "version": "0.1.0"
    },
    "services/worker": {
      "name": "@mediq/worker",
      "version": "0.1.0"
    },
    "web": {
      "name": "@mediq/web",
      "version": "0.1.0"
    }
  }
}
